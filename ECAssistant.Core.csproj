<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <RootNamespace>ECAssistant.Core</RootNamespace>
    <AssemblyName>ECAssistant.Core</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>ECAssistant.Core</PackageId>
    <Description>ECAssistant Core — local AI agent engine, tools, session management, and memory system.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ECAssistant.Core.Tests" />
    <InternalsVisibleTo Include="ECAssistant.Core.TestSupport" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <Compile Remove="TestSupport/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-order only: ensures the LLM server is built before Core so the staging
         target below can copy its output. Does NOT link Core against the server. -->
    <ProjectReference Include="..\ECAssistantLLM\ECAssistant.LLM.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SystemPrompt.Linux.md" />
    <EmbeddedResource Include="SystemPrompt.Windows.md" />
    <EmbeddedResource Include="SystemPrompt.Mac.md" />
    <EmbeddedResource Include="appsettings.json" />
    <EmbeddedResource Include="Setup\ModelCatalog.default.json" />
  </ItemGroup>

  <!-- Stage the LLM server runtime into $(OutDir)server/ so Core's own output is
       self-contained: the runtime copies root/server from BaseDirectory/server only. -->
  <Target Name="StageLlmServer" AfterTargets="Build">
    <PropertyGroup>
      <_LlmOutDir>$(MSBuildThisFileDirectory)..\ECAssistantLLM\bin\$(Configuration)\net8.0\</_LlmOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_LlmServerFiles Include="$(_LlmOutDir)**\*" Exclude="$(_LlmOutDir)**\*.log;$(_LlmOutDir)logs\**" />
    </ItemGroup>
    <Copy SourceFiles="@(_LlmServerFiles)"
          DestinationFiles="@(_LlmServerFiles->'$(OutDir)server\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>