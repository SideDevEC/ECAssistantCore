<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <RootNamespace>ECAssistant.Core</RootNamespace>
    <AssemblyName>ECAssistant.Core</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>ECAssistant.Core</PackageId>
    <PackageVersion>12.9.9</PackageVersion>
    <Authors>SideDevEC</Authors>
    <Company>SideDevEC</Company>
    <Product>ECAssistant</Product>
    <PackageTags>ecassistant;ai-agent;local-llm;tools;memory</PackageTags>
    <PackageProjectUrl>https://github.com/SideDevEC/ECAssistantCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SideDevEC/ECAssistantCore.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>ECAssistant Core — local AI agent engine, tools, session management, and memory system.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ECAssistant.Core.Tests" />
    <InternalsVisibleTo Include="ECAssistant.Core.TestSupport" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- LLM server package: provides the build target that copies the server runtime
         into the consumer's output (server/). Consumed as a NuGet dependency so
         downstream projects get the server automatically — no lib/ DLLs anywhere. -->
    <PackageReference Include="ECAssistant.LLM.Server" Version="14.9.5" Condition="'$(EcaUseProjectRefs)' != 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(EcaUseProjectRefs)' == 'true'">
    <ProjectReference Include="../ECAssistantLLM/ECAssistant.LLM.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(EcaUseProjectRefs)' != 'true'">
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SystemPrompt.Linux.md" />
    <EmbeddedResource Include="SystemPrompt.Windows.md" />
    <EmbeddedResource Include="SystemPrompt.Mac.md" />
    <EmbeddedResource Include="appsettings.json" />
    <EmbeddedResource Include="catalog\model-catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>