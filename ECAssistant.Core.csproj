<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <RootNamespace>ECAssistant.Core</RootNamespace>
    <AssemblyName>ECAssistant.Core</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>ECAssistant.Core</PackageId>
    <Description>ECAssistant Core — local AI agent engine, tools, session management, and memory system.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ECAssistant.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SystemPrompt.Linux.md" />
    <EmbeddedResource Include="SystemPrompt.Windows.md" />
    <EmbeddedResource Include="SystemPrompt.Mac.md" />
    <EmbeddedResource Include="appsettings.json" />
  </ItemGroup>

</Project>