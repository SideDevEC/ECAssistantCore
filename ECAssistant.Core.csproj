<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <RootNamespace>ECAssistant</RootNamespace>
    <AssemblyName>ECAssistant.Core</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>ECAssistant.Core</PackageId>
    <Description>ECAssistant Core — local AI agent engine, tools, session management, and memory system. Library for embedding ECAssistant into any .NET application.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- InternalsVisibleTo for test assemblies. Add consumer assemblies as needed. -->
    <InternalsVisibleTo Include="ECAssistant.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude Tests from Core library build -->
    <Compile Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.27.0" Condition="'$(OS)' == 'WINDOWS'" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed system prompts and default config into the DLL as resources -->
    <EmbeddedResource Include="SystemPrompt.md" />
    <EmbeddedResource Include="SystemPrompt.Windows.md" />
    <EmbeddedResource Include="SystemPrompt.Mac.md" />
    <EmbeddedResource Include="appsettings.json" />
  </ItemGroup>

  <!-- Native runtime files are included via build script (pack-core.sh) -->

</Project>