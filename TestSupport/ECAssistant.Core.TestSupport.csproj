<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <RootNamespace>ECAssistant.Core.TestSupport</RootNamespace>
    <AssemblyName>ECAssistant.Core.TestSupport</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- INTERNAL TEST HARNESS — never published to NuGet. Consumed by Core Tests
         (ProjectReference) and Console dev tests (cross-repo ProjectReference). -->
    <Authors>SideDevEC</Authors>
    <Company>SideDevEC</Company>
    <Product>ECAssistant</Product>
    <PackageProjectUrl>https://github.com/SideDevEC/ECAssistantCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SideDevEC/ECAssistantCore.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Test-support harness for ECAssistant.Core (TestRunner, scenarios, MockEngine). Not for production use.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECAssistant.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
