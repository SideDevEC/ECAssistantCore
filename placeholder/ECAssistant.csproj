<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>ECAssistant</PackageId>
    <Version>1.0.0</Version>
    <Authors>SideDevEC</Authors>
    <Description>ECAssistant — local-first AI agent platform. This is the namespace root package; install ECAssistant.Core to use the engine, or ECAssistant.TUI for the terminal UI.</Description>
    <PackageTags>ecassistant;ai-agent;local-llm</PackageTags>
    <PackageProjectUrl>https://github.com/SideDevEC/ECAssistantCore</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoTargets>true</NoTargets>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
